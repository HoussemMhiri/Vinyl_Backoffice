{
  "kind": "collectionType",
  "collectionName": "sellable_units",
  "info": {
    "singularName": "sellable-unit",
    "pluralName": "sellable-units",
    "displayName": "Sellable Unit",
    "description": "One physical copy of a product, priced and graded"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "inversedBy": "sellableUnits",
      "required": true
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "sellableUnits",
      "required": true
    },
    "sku": {
      "type": "string",
      "unique": true
    },
    "skuSequence": {
      "type": "integer",
      "private": true
    },
    "price": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "currency": {
      "type": "string",
      "default": "EUR",
      "required": true,
      "maxLength": 3
    },
    "mediaCondition": {
      "type": "enumeration",
      "enum": ["M", "NM", "VG_PLUS", "VG", "G_PLUS", "G", "F", "P"]
    },
    "sleeveCondition": {
      "type": "enumeration",
      "enum": ["M", "NM", "VG_PLUS", "VG", "G_PLUS", "G", "F", "P", "GENERIC", "NOT_GRADED", "NO_COVER"]
    },
    "sellerComment": {
      "type": "text"
    },
    "saleStatus": {
      "type": "enumeration",
      "enum": ["available", "reserved", "sold", "out_of_stock", "archived"],
      "default": "available",
      "required": true
    },
    "quantity": {
      "type": "integer",
      "default": 1,
      "required": true,
      "min": 0
    },
    "internalLocation": {
      "type": "string"
    },
    "channelListings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::channel-listing.channel-listing",
      "mappedBy": "sellableUnit"
    }
  }
}
